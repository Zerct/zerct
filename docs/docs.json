{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Tovuk",
  "description": "Use Tovuk scraper APIs and manage Rust services with agent-readable checks.",
  "colors": {
    "primary": "#171717",
    "light": "#FAFAFA",
    "dark": "#666666"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/tovuk-text-logo.svg",
    "dark": "/tovuk-text-logo.svg",
    "href": "https://tovuk.com"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist.woff2",
    "format": "woff2",
    "weight": 450,
    "heading": {
      "family": "Geist",
      "source": "/fonts/Geist.woff2",
      "format": "woff2",
      "weight": 650
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist.woff2",
      "format": "woff2",
      "weight": 450
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#0A0A0A"
    }
  },
  "styling": {
    "eyebrows": "section",
    "latex": false,
    "codeblocks": "dark"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start and Deploy",
            "pages": [
              "index",
              "quickstart",
              "scrapers",
              "agents",
              "templates",
              "deploy"
            ]
          },
          {
            "group": "Production and Cost",
            "pages": [
              "production-readiness",
              "pricing",
              "status"
            ]
          },
          {
            "group": "Help and Updates",
            "pages": [
              "support",
              "abuse",
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Build and Deploy",
            "pages": [
              "reference/project-contract",
              "reference/workers",
              "reference/products",
              "reference/packages",
              "reference/limits"
            ]
          },
          {
            "group": "Resources and Data",
            "pages": [
              "reference/resources",
              "reference/sqlite",
              "reference/state",
              "reference/kv",
              "reference/secrets",
              "reference/storage"
            ]
          },
          {
            "group": "Jobs and Connectivity",
            "pages": [
              "reference/queues",
              "reference/cron",
              "reference/bindings",
              "reference/domains"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "reference/logs-builds",
              "reference/usage-caps"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://tovuk.com",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/tovuk/tovuk",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://tovuk.com/account"
      },
      {
        "type": "github",
        "href": "https://github.com/tovuk/tovuk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://tovuk.com"
    }
  },
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      "windsurf"
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.tovuk.com"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "none"
    }
  },
  "search": {
    "prompt": "Search Tovuk docs"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tovukcloud",
      "github": "https://github.com/tovuk/tovuk"
    }
  }
}
