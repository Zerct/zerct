{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Zerct",
  "description": "Free Rust backend cloud for agents.",
  "colors": {
    "primary": "#FFFFFF",
    "light": "#FFFFFF",
    "dark": "#FFFFFF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/zerct-text-logo.svg",
    "dark": "/zerct-text-logo.svg",
    "href": "https://zerct.com"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/Geist.woff2",
    "format": "woff2",
    "weight": 450,
    "heading": {
      "family": "Geist",
      "source": "/fonts/Geist.woff2",
      "format": "woff2",
      "weight": 650
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist.woff2",
      "format": "woff2",
      "weight": 450
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#000000",
      "dark": "#000000"
    }
  },
  "styling": {
    "eyebrows": "section",
    "latex": false,
    "codeblocks": "dark"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart",
              "templates",
              "agents",
              "support",
              "status",
              "deploy"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/project-contract",
              "reference/full-stack",
              "reference/postgres",
              "reference/packages",
              "reference/limits"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://zerct.com",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/Zerct/zerct",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Zerct/zerct"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start free",
      "href": "https://zerct.com"
    }
  },
  "contextual": {
    "display": "toc",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.zerct.com"
    }
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "none"
    }
  },
  "search": {
    "prompt": "Search Zerct docs"
  },
  "footer": {
    "socials": {
      "x": "https://x.com/zerctcloud",
      "github": "https://github.com/Zerct/zerct"
    }
  }
}
