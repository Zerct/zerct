{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Zerct API",
    "summary": "Control-plane API for Zerct deployments.",
    "version": "0.1.0",
    "description": "Use the Zerct API to authenticate, create Rust backend deployments, manage account onboarding, and inspect deployment health.",
    "termsOfService": "https://zerct.com/legal/terms",
    "contact": {
      "name": "Zerct",
      "url": "https://zerct.com",
      "email": "support@zerct.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://zerct.com/legal"
    }
  },
  "externalDocs": {
    "description": "Zerct documentation",
    "url": "https://docs.zerct.com"
  },
  "servers": [
    {
      "url": "https://api.zerct.com",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Accounts",
      "description": "Private account onboarding and dashboard endpoints."
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints."
    },
    {
      "name": "Deployments",
      "description": "Deployment lifecycle endpoints."
    },
    {
      "name": "Health",
      "description": "API availability endpoints."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API health",
        "description": "Returns the Zerct control-plane health state.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "$ref": "#/components/responses/HealthOk"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v1/login/device": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Start device login",
        "description": "Starts a device login flow for the Zerct CLI.",
        "operationId": "startDeviceLogin",
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginStarted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v1/login/device/{device_code}": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Poll device login",
        "description": "Polls a first-run browser login until it is complete, pending, or expired.",
        "operationId": "pollDeviceLogin",
        "parameters": [
          {
            "name": "device_code",
            "in": "path",
            "description": "Opaque device code returned by start device login.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^zdev_[a-f0-9]{64}$"
            },
            "example": "zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginPolled"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v1/account": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get account profile",
        "description": "Returns the authenticated account profile used by web onboarding and SDK flows.",
        "operationId": "getAccountProfile",
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountProfileLoaded"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Accounts"
        ],
        "summary": "Update account profile",
        "description": "Sets the private Zerct handle and display name used for the authenticated dashboard.",
        "operationId": "updateAccountProfile",
        "requestBody": {
          "description": "Account handle and display name.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountProfileUpdateRequest"
              },
              "examples": {
                "acme": {
                  "summary": "Choose account handle",
                  "value": {
                    "handle": "acme",
                    "displayName": "Acme"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountProfileUpdated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v1/account/dashboard": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get account dashboard",
        "description": "Returns deployments and usage for the authenticated account dashboard.",
        "operationId": "getAccountDashboard",
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountDashboardLoaded"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/v1/deployments": {
      "post": {
        "tags": [
          "Deployments"
        ],
        "summary": "Create deployment",
        "description": "Creates a deployment from a source archive produced by the Zerct CLI.",
        "operationId": "createDeployment",
        "requestBody": {
          "description": "Deployment source archive and runtime metadata.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeployRequest"
              },
              "examples": {
                "helloRust": {
                  "summary": "Deploy a Rust backend",
                  "value": {
                    "appName": "hello-rust",
                    "healthPath": "/healthz",
                    "archiveBase64": "H4sIAAAAAAAA"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeploymentAccepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Zerct session token returned by the login flow. JWT handling follows RFC8725 best current practices."
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Maximum requests available in the current rate-limit window.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100000,
          "examples": [
            1000
          ]
        }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining in the current rate-limit window.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 100000,
          "examples": [
            999
          ]
        }
      },
      "RateLimitReset": {
        "description": "Unix timestamp for the end of the current rate-limit window.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1700000000,
          "maximum": 4102444800,
          "examples": [
            1779710400
          ]
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying a rate-limited request.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 3600,
          "examples": [
            60
          ]
        }
      }
    },
    "responses": {
      "HealthOk": {
        "description": "The API is healthy.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HealthResponse"
            },
            "examples": {
              "healthy": {
                "summary": "Healthy response",
                "value": {
                  "ok": true,
                  "service": "zerct-api"
                }
              }
            }
          }
        }
      },
      "LoginStarted": {
        "description": "Device login information.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LoginStartResponse"
            },
            "examples": {
              "deviceLogin": {
                "summary": "Device login",
                "value": {
                  "loginUrl": "https://zerct.com/login?device_code=zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&user_code=ABC123",
                  "verificationUri": "https://zerct.com/login",
                  "deviceCode": "zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                  "userCode": "ABC123",
                  "intervalSeconds": 5,
                  "expiresInSeconds": 600
                }
              }
            }
          }
        }
      },
      "LoginPolled": {
        "description": "Device login poll result.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LoginPollResponse"
            },
            "examples": {
              "complete": {
                "summary": "Login complete",
                "value": {
                  "status": "complete",
                  "intervalSeconds": 5,
                  "accountId": "acct_01HW0000000000000000000000",
                  "email": "dev@example.com",
                  "provider": "github",
                  "token": "zct_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                  "expiresAt": "2026-06-24T12:00:00.000Z"
                }
              },
              "pending": {
                "summary": "Login pending",
                "value": {
                  "status": "pending",
                  "intervalSeconds": 5,
                  "accountId": null,
                  "email": null,
                  "provider": null,
                  "token": null,
                  "expiresAt": null
                }
              }
            }
          }
        }
      },
      "DeploymentAccepted": {
        "description": "Deployment accepted.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DeployResponse"
            },
            "examples": {
              "queuedDeployment": {
                "summary": "Queued deployment",
                "value": {
                  "deployId": "dep_01HW0000000000000000000000",
                  "appId": "app_01HW0000000000000000000000",
                  "status": "queued",
                  "url": "https://hello-rust.zerct.app"
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request body or parameters are invalid.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalidRequest": {
                "summary": "Invalid request",
                "value": {
                  "code": "invalid_request",
                  "message": "Request validation failed.",
                  "agentInstruction": "Fix the request payload and retry.",
                  "traceId": "trc_01HW0000000000000000000000"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required or the token is invalid.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "loginRequired": {
                "summary": "Login required",
                "value": {
                  "code": "login_required",
                  "message": "Zerct login is required.",
                  "agentInstruction": "Run zerct login and retry.",
                  "traceId": "trc_01HW0000000000000000000001"
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "The rate limit has been exceeded.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "rateLimited": {
                "summary": "Rate limited",
                "value": {
                  "code": "rate_limited",
                  "message": "Too many requests.",
                  "agentInstruction": "Wait for the rate-limit reset, then retry.",
                  "traceId": "trc_01HW0000000000000000000002"
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "The API could not complete the request.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "serverError": {
                "summary": "Server error",
                "value": {
                  "code": "internal_error",
                  "message": "The API could not complete the request.",
                  "agentInstruction": "Retry the request. If it keeps failing, check Zerct status.",
                  "traceId": "trc_01HW0000000000000000000003"
                }
              }
            }
          }
        }
      },
      "AccountProfileLoaded": {
        "description": "Signed-in account profile response.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountProfileResponse"
            },
            "examples": {
              "ready": {
                "summary": "Account profile with handle",
                "value": {
                  "accountId": "acct_01HW0000000000000000000000",
                  "email": "dev@example.com",
                  "provider": "github",
                  "handle": "acme",
                  "displayName": "Acme",
                  "accountUrl": "https://zerct.com/acme"
                }
              }
            }
          }
        }
      },
      "AccountProfileUpdated": {
        "description": "Updated authenticated account profile.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountProfileResponse"
            },
            "examples": {
              "updated": {
                "summary": "Updated account profile",
                "value": {
                  "accountId": "acct_01HW0000000000000000000000",
                  "email": "dev@example.com",
                  "provider": "github",
                  "handle": "acme",
                  "displayName": "Acme",
                  "accountUrl": "https://zerct.com/acme"
                }
              }
            }
          }
        }
      },
      "AccountDashboardLoaded": {
        "description": "Authenticated account dashboard.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountDashboardResponse"
            },
            "examples": {
              "dashboard": {
                "summary": "Account dashboard",
                "value": {
                  "profile": {
                    "accountId": "acct_01HW0000000000000000000000",
                    "email": "dev@example.com",
                    "provider": "github",
                    "handle": "acme",
                    "displayName": "Acme",
                    "accountUrl": "https://zerct.com/acme"
                  },
                  "apps": [
                    {
                      "appId": "app_01HW0000000000000000000000",
                      "name": "hello-rust",
                      "slug": "hello-rust",
                      "url": "https://hello-rust.zerct.app",
                      "plan": "free",
                      "runtimeStatus": "running",
                      "latestBuildStatus": "succeeded",
                      "deployCount": 3,
                      "runtimeMemoryMib": 256,
                      "runtimeCpuMillis": 250,
                      "databaseStorageMib": 512,
                      "idleTimeoutMinutes": 15,
                      "latestDeployAt": "2026-05-25T12:00:00.000Z"
                    }
                  ],
                  "usage": {
                    "appCount": 1,
                    "runningCount": 1,
                    "runtimeMemoryMib": 256,
                    "runtimeCpuMillis": 250,
                    "databaseStorageMib": 512,
                    "deployCount": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "description": "Health response for the control-plane API.",
        "additionalProperties": false,
        "required": [
          "ok",
          "service"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Whether the API is healthy.",
            "examples": [
              true
            ]
          },
          "service": {
            "type": "string",
            "description": "Service identifier.",
            "enum": [
              "zerct-api"
            ],
            "examples": [
              "zerct-api"
            ]
          }
        },
        "examples": [
          {
            "ok": true,
            "service": "zerct-api"
          }
        ]
      },
      "LoginStartResponse": {
        "type": "object",
        "description": "Device login response for the Zerct CLI.",
        "additionalProperties": false,
        "required": [
          "loginUrl",
          "verificationUri",
          "deviceCode",
          "userCode",
          "intervalSeconds",
          "expiresInSeconds"
        ],
        "properties": {
          "loginUrl": {
            "type": "string",
            "description": "Browser URL where the user completes login.",
            "format": "uri",
            "examples": [
              "https://zerct.com/login?device_code=zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&user_code=ABC123"
            ]
          },
          "verificationUri": {
            "type": "string",
            "description": "Browser URL where the user chooses GitHub or Google.",
            "format": "uri",
            "examples": [
              "https://zerct.com/login"
            ]
          },
          "deviceCode": {
            "type": "string",
            "description": "Opaque code used by the CLI polling endpoint.",
            "pattern": "^zdev_[a-f0-9]{64}$",
            "examples": [
              "zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            ]
          },
          "userCode": {
            "type": "string",
            "description": "Short human-readable code shown by the CLI during login.",
            "pattern": "^[A-F0-9]{6}$",
            "examples": [
              "ABC123"
            ]
          },
          "intervalSeconds": {
            "type": "integer",
            "description": "Minimum polling interval in seconds.",
            "format": "int32",
            "minimum": 1,
            "maximum": 60,
            "examples": [
              5
            ]
          },
          "expiresInSeconds": {
            "type": "integer",
            "description": "Device login lifetime in seconds.",
            "format": "int32",
            "minimum": 60,
            "maximum": 1800,
            "examples": [
              600
            ]
          }
        },
        "examples": [
          {
            "loginUrl": "https://zerct.com/login?device_code=zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&user_code=ABC123",
            "verificationUri": "https://zerct.com/login",
            "deviceCode": "zdev_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "userCode": "ABC123",
            "intervalSeconds": 5,
            "expiresInSeconds": 600
          }
        ]
      },
      "LoginPollResponse": {
        "type": "object",
        "description": "Device login polling response for the Zerct CLI.",
        "additionalProperties": false,
        "required": [
          "status",
          "intervalSeconds",
          "accountId",
          "email",
          "provider",
          "token",
          "expiresAt"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Current device login state.",
            "enum": [
              "pending",
              "complete",
              "expired"
            ],
            "examples": [
              "complete"
            ]
          },
          "intervalSeconds": {
            "type": "integer",
            "description": "Minimum seconds to wait before the next poll.",
            "format": "int32",
            "minimum": 1,
            "maximum": 60,
            "examples": [
              5
            ]
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Authenticated Zerct account id when login is complete.",
            "pattern": "^acct_[A-Za-z0-9_-]+$",
            "examples": [
              "acct_01HW0000000000000000000000"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Verified provider email when login is complete.",
            "format": "email",
            "examples": [
              "dev@example.com"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "Identity provider used when login is complete.",
            "enum": [
              "github",
              "google",
              null
            ],
            "examples": [
              "github"
            ]
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Zerct session token returned once and stored by the CLI.",
            "pattern": "^zct_[a-f0-9]{64}$",
            "examples": [
              "zct_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            ]
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "UTC timestamp when the Zerct session token expires.",
            "format": "date-time",
            "examples": [
              "2026-06-24T12:00:00.000Z"
            ]
          }
        },
        "examples": [
          {
            "status": "complete",
            "intervalSeconds": 5,
            "accountId": "acct_01HW0000000000000000000000",
            "email": "dev@example.com",
            "provider": "github",
            "token": "zct_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "expiresAt": "2026-06-24T12:00:00.000Z"
          }
        ]
      },
      "DeployRequest": {
        "type": "object",
        "description": "Request body for creating a deployment.",
        "additionalProperties": false,
        "required": [
          "appName",
          "healthPath",
          "archiveBase64"
        ],
        "properties": {
          "appName": {
            "type": "string",
            "description": "Deployment slug.",
            "pattern": "^[a-z][a-z0-9-]{2,62}$",
            "examples": [
              "hello-rust"
            ]
          },
          "healthPath": {
            "type": "string",
            "description": "HTTP path used by Zerct health checks.",
            "pattern": "^/[A-Za-z0-9/_-]{1,120}$",
            "examples": [
              "/healthz"
            ]
          },
          "archiveBase64": {
            "type": "string",
            "description": "Base64 encoded source archive.",
            "format": "byte",
            "maxLength": 52428800,
            "examples": [
              "H4sIAAAAAAAA"
            ]
          }
        },
        "examples": [
          {
            "appName": "hello-rust",
            "healthPath": "/healthz",
            "archiveBase64": "H4sIAAAAAAAA"
          }
        ]
      },
      "DeployResponse": {
        "type": "object",
        "description": "Response returned after a deployment is accepted.",
        "additionalProperties": false,
        "required": [
          "deployId",
          "appId",
          "status"
        ],
        "properties": {
          "deployId": {
            "type": "string",
            "description": "Deployment identifier.",
            "pattern": "^dep_[0-9A-HJKMNP-TV-Z]{26}$",
            "examples": [
              "dep_01HW0000000000000000000000"
            ]
          },
          "appId": {
            "type": "string",
            "description": "Application identifier.",
            "pattern": "^app_[0-9A-HJKMNP-TV-Z]{26}$",
            "examples": [
              "app_01HW0000000000000000000000"
            ]
          },
          "status": {
            "type": "string",
            "description": "Deployment status.",
            "enum": [
              "queued",
              "building",
              "running",
              "failed"
            ],
            "examples": [
              "queued"
            ]
          },
          "url": {
            "type": "string",
            "description": "Public deployment URL.",
            "format": "uri",
            "examples": [
              "https://hello-rust.zerct.app"
            ]
          }
        },
        "examples": [
          {
            "deployId": "dep_01HW0000000000000000000000",
            "appId": "app_01HW0000000000000000000000",
            "status": "queued",
            "url": "https://hello-rust.zerct.app"
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error response with agent-readable recovery guidance.",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "agentInstruction",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "examples": [
              "invalid_request"
            ]
          },
          "message": {
            "type": "string",
            "description": "Short human-readable error message.",
            "pattern": "^[A-Za-z0-9 .,:/_-]{3,160}$",
            "examples": [
              "Request validation failed."
            ]
          },
          "agentInstruction": {
            "type": "string",
            "description": "Instruction an AI agent can follow to recover.",
            "pattern": "^[A-Za-z0-9 .,:/_-]{3,240}$",
            "examples": [
              "Fix the request payload and retry."
            ]
          },
          "traceId": {
            "type": "string",
            "description": "Support trace identifier.",
            "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
            "examples": [
              "trc_01HW0000000000000000000000"
            ]
          }
        },
        "examples": [
          {
            "code": "invalid_request",
            "message": "Request validation failed.",
            "agentInstruction": "Fix the request payload and retry.",
            "traceId": "trc_01HW0000000000000000000000"
          }
        ]
      },
      "AuthProvider": {
        "type": "string",
        "description": "OAuth provider used by the Zerct account.",
        "enum": [
          "github",
          "google"
        ],
        "examples": [
          "github"
        ]
      },
      "Plan": {
        "type": "string",
        "description": "Zerct plan assigned to a deployment.",
        "enum": [
          "free",
          "pro"
        ],
        "examples": [
          "free"
        ]
      },
      "RuntimeStatus": {
        "type": "string",
        "description": "Current runtime state.",
        "enum": [
          "running",
          "sleeping",
          "starting",
          "stopping",
          "failed"
        ],
        "examples": [
          "running"
        ]
      },
      "BuildStatus": {
        "type": [
          "string",
          "null"
        ],
        "description": "Latest build state when a build exists.",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "canceled",
          null
        ],
        "examples": [
          "succeeded"
        ]
      },
      "AccountProfileResponse": {
        "type": "object",
        "description": "Account profile returned to the signed-in user.",
        "additionalProperties": false,
        "required": [
          "accountId",
          "email",
          "provider",
          "handle",
          "displayName",
          "accountUrl"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Authenticated Zerct account id.",
            "pattern": "^acct_[A-Za-z0-9_-]+$",
            "examples": [
              "acct_01HW0000000000000000000000"
            ]
          },
          "email": {
            "type": "string",
            "description": "Provider email for the authenticated account.",
            "format": "email",
            "examples": [
              "dev@example.com"
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/AuthProvider"
          },
          "handle": {
            "type": [
              "string",
              "null"
            ],
            "description": "Private Zerct account handle.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,37}[a-z0-9]$",
            "examples": [
              "acme"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "description": "Saved display name for the account.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$",
            "minLength": 1,
            "maxLength": 80,
            "examples": [
              "Acme"
            ]
          },
          "accountUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Private account dashboard URL.",
            "format": "uri",
            "examples": [
              "https://zerct.com/acme"
            ]
          }
        }
      },
      "AccountProfileUpdateRequest": {
        "type": "object",
        "description": "Account profile update request.",
        "additionalProperties": false,
        "required": [
          "handle",
          "displayName"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "description": "Unique lowercase account handle.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,37}[a-z0-9]$",
            "minLength": 3,
            "maxLength": 39,
            "examples": [
              "acme"
            ]
          },
          "displayName": {
            "type": "string",
            "description": "Display name shown in the private dashboard.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$",
            "minLength": 1,
            "maxLength": 80,
            "examples": [
              "Acme"
            ]
          }
        }
      },
      "AccountDashboardResponse": {
        "type": "object",
        "description": "Authenticated account dashboard response.",
        "additionalProperties": false,
        "required": [
          "profile",
          "apps",
          "usage"
        ],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/AccountProfileResponse"
          },
          "apps": {
            "type": "array",
            "description": "Deployments owned by the account.",
            "minItems": 0,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/AccountDashboardApp"
            },
            "examples": [
              [
                {
                  "appId": "app_01HW0000000000000000000000",
                  "name": "hello-rust",
                  "slug": "hello-rust",
                  "url": "https://hello-rust.zerct.app",
                  "plan": "free",
                  "runtimeStatus": "running",
                  "latestBuildStatus": "succeeded",
                  "deployCount": 3,
                  "runtimeMemoryMib": 256,
                  "runtimeCpuMillis": 250,
                  "databaseStorageMib": 512,
                  "idleTimeoutMinutes": 15,
                  "latestDeployAt": "2026-05-25T12:00:00.000Z"
                }
              ]
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/AccountDashboardUsage"
          }
        }
      },
      "AccountDashboardApp": {
        "type": "object",
        "description": "Dashboard deployment row.",
        "additionalProperties": false,
        "required": [
          "appId",
          "name",
          "slug",
          "url",
          "plan",
          "runtimeStatus",
          "latestBuildStatus",
          "deployCount",
          "runtimeMemoryMib",
          "runtimeCpuMillis",
          "databaseStorageMib",
          "idleTimeoutMinutes",
          "latestDeployAt"
        ],
        "properties": {
          "appId": {
            "type": "string",
            "description": "App id shown on the account dashboard.",
            "pattern": "^app_[0-9A-HJKMNP-TV-Z]{26}$",
            "examples": [
              "app_01HW0000000000000000000000"
            ]
          },
          "name": {
            "type": "string",
            "description": "Service name.",
            "pattern": "^[a-z][a-z0-9-]{2,62}$",
            "examples": [
              "hello-rust"
            ]
          },
          "slug": {
            "type": "string",
            "description": "Public deployment slug.",
            "pattern": "^[a-z][a-z0-9-]{2,62}$",
            "examples": [
              "hello-rust"
            ]
          },
          "url": {
            "type": "string",
            "description": "HTTPS endpoint assigned to the deployment.",
            "format": "uri",
            "examples": [
              "https://hello-rust.zerct.app"
            ]
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "runtimeStatus": {
            "$ref": "#/components/schemas/RuntimeStatus"
          },
          "latestBuildStatus": {
            "$ref": "#/components/schemas/BuildStatus"
          },
          "deployCount": {
            "type": "integer",
            "description": "Number of deploy records.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000,
            "examples": [
              3
            ]
          },
          "runtimeMemoryMib": {
            "type": "integer",
            "description": "Runtime memory limit in MiB.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1048576,
            "examples": [
              256
            ]
          },
          "runtimeCpuMillis": {
            "type": "integer",
            "description": "Runtime CPU limit in millis.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000,
            "examples": [
              250
            ]
          },
          "databaseStorageMib": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Managed Postgres storage limit in MiB when enabled.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1048576,
            "examples": [
              512
            ]
          },
          "idleTimeoutMinutes": {
            "type": "integer",
            "description": "Idle timeout in minutes.",
            "format": "int64",
            "minimum": 0,
            "maximum": 10080,
            "examples": [
              15
            ]
          },
          "latestDeployAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest deploy creation timestamp.",
            "format": "date-time",
            "examples": [
              "2026-05-25T12:00:00.000Z"
            ]
          }
        }
      },
      "AccountDashboardUsage": {
        "type": "object",
        "description": "Aggregated account dashboard usage.",
        "additionalProperties": false,
        "required": [
          "appCount",
          "runningCount",
          "runtimeMemoryMib",
          "runtimeCpuMillis",
          "databaseStorageMib",
          "deployCount"
        ],
        "properties": {
          "appCount": {
            "type": "integer",
            "description": "Number of apps.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000,
            "examples": [
              1
            ]
          },
          "runningCount": {
            "type": "integer",
            "description": "Number of running apps.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000,
            "examples": [
              1
            ]
          },
          "runtimeMemoryMib": {
            "type": "integer",
            "description": "Sum of runtime memory limits in MiB.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1048576,
            "examples": [
              256
            ]
          },
          "runtimeCpuMillis": {
            "type": "integer",
            "description": "Sum of runtime CPU limits in millis.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000,
            "examples": [
              250
            ]
          },
          "databaseStorageMib": {
            "type": "integer",
            "description": "Sum of managed database storage limits in MiB.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1048576,
            "examples": [
              512
            ]
          },
          "deployCount": {
            "type": "integer",
            "description": "Sum of deployment records.",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000,
            "examples": [
              3
            ]
          }
        }
      }
    }
  }
}
