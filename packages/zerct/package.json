{
  "name": "zerct",
  "version": "0.1.21",
  "description": "Deploy Rust backends and static frontends to Zerct.",
  "type": "module",
  "bin": {
    "zerct": "bin/zerct.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "zerct",
    "rust",
    "deploy",
    "backend",
    "hosting"
  ],
  "homepage": "https://zerct.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zerct/zerct.git",
    "directory": "packages/zerct"
  },
  "bugs": {
    "url": "https://github.com/Zerct/zerct/issues"
  },
  "license": "MIT",
  "scripts": {
    "check": "node --check bin/zerct.js && for file in bin/internal/*.js; do node --check \"$file\"; done",
    "pack:dry": "npm pack --dry-run"
  }
}
